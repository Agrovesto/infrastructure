%% Diagram 1 of 3 - runtime and boundaries: who talks to what, and where it lives.
%% Render at https://mermaid.live or any Mermaid-aware viewer.
%% Telemetry and cost flows: telemetry.mmd. Pipelines and state: cicd.mmd.
flowchart LR

  subgraph edge["Internet / DNS edge"]
    direction TB
    users["Users<br/>browsers"]
    r53["Route53<br/>nomaos.com + agrovesto zones"]
    acm["ACM<br/>wildcard *.nomaos.com"]
    amplify["Amplify CDN<br/>2 React front ends"]
  end

  subgraph prod["AWS account 221434544570 - prod, eu-west-1"]
    direction TB

    subgraph pvpc["VPC agrovesto-prod-vpc"]
      direction TB

      subgraph ppublic["Public subnet"]
        igw["Internet Gateway"]
        natgw["NAT gateway<br/>1 shared, single AZ + EIP"]
        alb["ALB agrovesto-prod-alb<br/>443, 80 redirects to 443"]
      end

      subgraph pprivate["Private subnet"]
        subgraph papp["ECS cluster main - Fargate, ARM64"]
          api1["wallet :5001<br/>256 vCPU / 512 MiB"]
          api2["onboarding :5002<br/>256 vCPU / 512 MiB"]
          api3["input :5003<br/>256 vCPU / 512 MiB"]
          api4["moneval :5004<br/>256 vCPU / 512 MiB"]
          api5["serviceprovider :5005<br/>256 vCPU / 512 MiB"]
          vaultsvc["vault service<br/>secrets store, not initialised"]
        end

        subgraph pmon["ECS cluster monitoring - Fargate, 512 vCPU / 1024 MiB each"]
          prom["prometheus :9090"]
          loki["loki :3100"]
          tempo["tempo :3200<br/>OTLP 4317 / 4318"]
          grafana["grafana :3000"]
          edgetask["edge task<br/>alloy 3100/4317/4318/12345<br/>alertmanager 9093<br/>blackbox 9115<br/>pushgateway 9091"]
        end

        efs_mon["EFS One Zone<br/>monitoring state"]
        efs_vault["EFS multi-AZ<br/>vault raft"]
      end

      subgraph pdb["Database subnet"]
        rds["RDS SQL Server Express<br/>db.t3.micro, 20 GB gp3, single AZ"]
      end
    end

    subgraph pshared["Account services"]
      direction TB
      ecr["ECR<br/>5 repos, IMMUTABLE"]
      sm["Secrets Manager<br/>mssql master"]
      kms["KMS keys<br/>vault + monitoring"]
      s3logs["S3 bucket<br/>ALB access logs"]
      cwl["CloudWatch Logs<br/>30-day retention"]
      cloudmap["Cloud Map<br/>monitoring.internal"]
      ssm["SSM Parameter Store<br/>grafana admin"]
    end
  end

  subgraph dev["AWS account 353833416626 - dev, eu-west-1"]
    direction TB
    subgraph dvpc["VPC - single public subnet"]
      direction TB
      digw["Internet Gateway"]
      deip["Elastic IP"]
      decs["EC2 instance t3.medium"]
      subgraph dhost["docker compose on the host"]
        dnginx["nginx 1.27-alpine<br/>reverse proxy"]
        dapis["5 API containers<br/>5001 to 5005"]
        dmssql["SQL Server container<br/>5 databases"]
        dvault["vault container"]
      end
      droot["50 GB root + 50 GB data<br/>gp3"]
    end
    subgraph dshared["Account services"]
      direction TB
      decr["ECR<br/>5 repos, MUTABLE"]
      ds3["S3 bucket<br/>SQL dumps, 14-day expiry"]
      dsched["EventBridge Scheduler<br/>start 08:00, stop 20:00, Mon to Fri"]
      damplify["Amplify apps<br/>2 branches + domains"]
    end
  end

  users -->|"DNS query 53"| r53
  r53 -->|"A / alias records"| alb
  users -->|"HTTPS 443"| alb
  alb -->|"HTTPS 443 to :5001"| api1
  alb -->|"HTTPS 443 to :5002"| api2
  alb -->|"HTTPS 443 to :5003"| api3
  alb -->|"HTTPS 443 to :5004"| api4
  alb -->|"HTTPS 443 to :5005"| api5
  alb -->|"listener rule, HTTPS 443 to :3000"| grafana
  acm -->|"certificate for the 443 listener"| alb
  users -->|"HTTPS 443"| amplify
  amplify -->|"static assets"| damplify

  users -->|"HTTPS 443 to nginx"| deip
  deip -->|"Elastic IP attached"| decs
  decs -->|"docker compose network"| dnginx
  dnginx -->|"HTTP 5001 to 5005"| dapis
  dapis -->|"TDS 1433"| dmssql
  dapis -->|"HTTP 8200"| dvault
  decs -->|"EBS attach"| droot
  dsched -->|"EC2 start / stop API calls"| decs
  r53 -.->|"dev hostnames, values typed in by hand"| deip

  api1 -->|"TDS 1433"| rds
  api2 -->|"TDS 1433"| rds
  api3 -->|"TDS 1433"| rds
  api4 -->|"TDS 1433"| rds
  api5 -->|"TDS 1433"| rds
  api1 -->|"HTTPS GetSecretValue"| sm
  vaultsvc -->|"NFS 2049"| efs_vault
  vaultsvc -->|"HTTPS Decrypt"| kms
  prom -->|"NFS 2049"| efs_mon
  loki -->|"NFS 2049"| efs_mon
  tempo -->|"NFS 2049"| efs_mon
  grafana -->|"NFS 2049"| efs_mon
  edgetask -->|"NFS 2049"| efs_mon
  grafana -->|"SSM GetParameter"| ssm
  pmon -->|"DNS A records, 10 s TTL"| cloudmap
  papp -->|"HTTPS 443 image pulls"| ecr
  alb -->|"S3 PutObject access logs"| s3logs
  papp -->|"awslogs driver"| cwl
  pmon -->|"awslogs driver"| cwl
  dapis -->|"HTTPS 443 image pulls"| decr
  dmssql -->|"S3 PutObject nightly dumps"| ds3
  dsched -->|"S3 upload"| ds3

  subgraph legend["Key"]
    l1["solid = deployed today"]
    l2["dashed = planned or disabled"]
  end

classDef internet fill:#eceff1,stroke:#607d8b,color:#263238
classDef managed fill:#fff3e0,stroke:#ef6c00,color:#3e2723
classDef compute fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
classDef data fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
classDef observability fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
classDef planned fill:#fafafa,stroke:#9e9e9e,stroke-dasharray:5,color:#616161

class users,r53,acm,amplify internet
class igw,natgw,alb,ecr,sm,kms,s3logs,cwl,cloudmap,ssm,digw,deip,decs,decr,ds3,dsched,damplify managed
class api1,api2,api3,api4,api5,vaultsvc,dnginx,dapis,dvault,droot,dmssql,rds compute
class efs_mon,efs_vault data
class prom,loki,tempo,grafana,edgetask observability
class l2 planned
