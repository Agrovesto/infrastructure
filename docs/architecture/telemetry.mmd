%% Diagram 2 of 3 - telemetry and cost data flow.
%% Everything here runs in the prod account; the only open-source-only
%% constraint in the estate applies to this stack.
%% Runtime and boundaries: architecture.mmd. Pipelines and state: cicd.mmd.
flowchart LR

  subgraph prodside["Prod application (producers)"]
    direction TB
    apis["ECS API services x5"]
    vaultapp["vault service"]
    rdsapp["RDS SQL Server Express<br/>5 databases"]
    albtargets["7 HTTPS endpoints<br/>5 APIs, vault health, grafana health"]
  end

  subgraph awsdata["AWS data and control planes"]
    direction TB
    ecsapi["ECS API<br/>DescribeServices / DescribeTasks"]
    smsec["Secrets Manager<br/>mssql master secret"]
    cur["Cost and Usage Report<br/>daily, Parquet, us-east-1"]
    s3cur["S3 bucket cur"]
    s3cfg["S3 bucket config<br/>dashboards, rule files, probe config, scripts"]
    cwl["CloudWatch Logs<br/>platform/support task diagnostics"]
    cwapi["CloudWatch metrics API<br/>ListMetrics and GetMetricData"]
    s3alb["S3 bucket alb access logs"]
    ses["SES<br/>domain identity + DKIM"]
    ssm["SSM Parameter Store"]
  end

  subgraph collect["Scheduled Fargate tasks"]
    direction TB
    collector["collector<br/>rate 2 min<br/>ecs metrics/state,<br/>cloudwatch metrics, alb shipper"]
    mssqljob["mssql-metrics<br/>rate 1 h"]
    budgetjob["budget<br/>cron 15 6 daily"]
    reportjob["report<br/>cron 0 8 1st of month"]
  end

  subgraph stack["Monitoring stack - ECS cluster monitoring"]
    direction TB
    init["init container<br/>aws s3 sync"]
    alloy["alloy<br/>OTLP 4317 / 4318, Loki push 3100"]
    pushgw["pushgateway :9091"]
    blkbox["blackbox-exporter :9115"]
    prom["prometheus :9090<br/>15-day retention"]
    loki["loki :3100<br/>30-day retention"]
    tempo["tempo :3200<br/>14-day retention"]
    alertmgr["alertmanager :9093"]
    grafana["grafana :3000"]
    efs["EFS One Zone<br/>one access point per component"]
  end

  subgraph out["Outputs"]
    direction TB
    viewer["Operator<br/>queried from inside the VPC"]
    mailbox["Report recipients<br/>PDF by e-mail"]
    receivers["Alert receiver<br/>SNS agrovesto-prod-alerts"]
  end

  %% ── ingest paths ─────────────────────────────────────────────────
  apis -->|"OTLP 4317/4318 traces, metrics and logs"| alloy
  vaultapp -->|"HTTP 12345 scrape"| prom
  vaultapp -->|"awslogs task diagnostics"| cwl
  alloy -->|"OTLP 4317 to tempo"| tempo
  alloy -->|"HTTP 3100 push"| loki
  tempo -->|"remote write metrics-generator"| prom
  loki -->|"HTTP 3100 query"| grafana
  tempo -->|"HTTP 3200 query"| grafana
  prom -->|"HTTP 9090 query"| grafana
  blkbox -->|"HTTPS probe every 15 s"| albtargets
  prom -->|"HTTP 9115 scrape probe results"| blkbox
  prom -->|"HTTP 9091 scrape"| pushgw
  prom -->|"HTTP 9093 alert rules"| alertmgr
  alertmgr -->|"SNS notification, sigv4"| receivers
  loki -->|"HTTP 9093 ruler alerts"| alertmgr
  efs -->|"NFS 2049"| prom
  efs -->|"NFS 2049"| loki
  efs -->|"NFS 2049"| tempo
  efs -->|"NFS 2049"| grafana
  efs -->|"NFS 2049"| alertmgr
  s3cfg -->|"S3 GetObject on start"| init
  init -->|"config on the shared volume"| prom
  ssm -->|"HTTPS GetParameter"| grafana
  grafana -->|"HTTPS 443 graphics and dashboards"| viewer

  %% ── batch job paths, control plane ───────────────────────────────
  collector -->|"HTTPS DescribeServices and DescribeTasks"| ecsapi
  ecsapi -->|"task and service metrics"| collector
  collector -->|"awslogs task diagnostics"| cwl
  collector -->|"HTTP 9091 push"| pushgw
  collector -->|"HTTPS GetMetricData, basic metrics only"| cwapi
  collector -->|"S3 ListBucket and GetObject"| s3alb
  collector -->|"HTTP 3100 push access logs"| loki
  mssqljob -->|"HTTPS GetSecretValue"| smsec
  smsec -->|"host, port, user, password"| mssqljob
  mssqljob -->|"TDS 1433 DMV query"| rdsapp
  mssqljob -->|"HTTP 9091 push<br/>mssql_database_size_bytes"| pushgw

  %% ── cost pipeline ────────────────────────────────────────────────
  cur -->|"S3 PutObject daily Parquet"| s3cur
  budgetjob -->|"S3 GetObject Parquet"| s3cur
  budgetjob -->|"DuckDB budget metrics<br/>HTTP 9091 push"| pushgw
  reportjob -->|"S3 GetObject Parquet"| s3cur
  reportjob -->|"fpdf2 render, then SES SendRawEmail"| ses
  reportjob -->|"HTTP 9091 push<br/>closed-month cost metrics"| pushgw
  ses -->|"monthly PDF"| mailbox
  pushgw -->|"scraped by prometheus"| prom
  prom -->|"budget dashboard and alert at 80 percent of 250 USD"| grafana

  subgraph legend["Key"]
    l1["solid = deployed today"]
    l2["dashed = planned or disabled"]
  end

classDef managed fill:#fff3e0,stroke:#ef6c00,color:#3e2723
classDef compute fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
classDef data fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
classDef observability fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
classDef internet fill:#eceff1,stroke:#607d8b,color:#263238
classDef planned fill:#fafafa,stroke:#9e9e9e,stroke-dasharray:5,color:#616161

class apis,vaultapp,albtargets,rdsapp compute
class ecsapi,smsec,cur,s3cur,s3cfg,ses,ssm,cwl,cwapi,s3alb managed
class init,pushgw,blkbox,alloy managed
class prom,loki,tempo,alertmgr,grafana,efs observability
class collector,mssqljob,budgetjob,reportjob observability
class viewer,mailbox,receivers internet
