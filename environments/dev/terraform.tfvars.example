# Copy to terraform.tfvars (gitignored) or convert with scripts/tfvars-to-json.py for GitHub TF_VARS_JSON.
# Replace every PLACEHOLDER before the first push to the dev branch.

project            = "agrovesto"
account_id         = "111111111111"          # PLACEHOLDER: real dev AWS account
peer_account_id    = "222222222222"          # PLACEHOLDER: real prod AWS account
aws_region         = "eu-west-1"
availability_zones = ["eu-west-1a", "eu-west-1b"]
permissions_boundary_arn = "arn:aws:iam::111111111111:policy/agrovesto-bootstrap-dev-workload-boundary"
zone_name          = "dev.example.com"       # PLACEHOLDER
# existing_zone_id = "Zxxxxxxxxxxxx"         # set when bootstrap (or registrar) already owns the zone
alert_emails       = ["ops@example.com"]     # PLACEHOLDER; confirm SNS subscription
monthly_budget_usd = 200
accept_sqlserver_eula = false                # set true only after accepting the Microsoft EULA
instance_type      = "t3.xlarge"             # 5 APIs + SQL Server Developer on one host

# ECR repos for 5 APIs + 2 frontends (images published separately)
ecr_repositories = [
  "core",
  "auth",
  "trading",
  "catalog",
  "notifications",
  "portal",
  "admin",
]

# One SQL database + login per API
databases = {
  core          = "AgrovestoCore"
  auth          = "AgrovestoAuth"
  trading       = "AgrovestoTrading"
  catalog       = "AgrovestoCatalog"
  notifications = "AgrovestoNotifications"
}

# False until images are in ECR and SQL has been provisioned on the host
services_enabled = false

# Host ports must be unique and not 1433. Images: account ECR + immutable tag (not :latest).
# After first publish, replace ACCOUNT and TAG with real values, then set services_enabled = true.
services = {
  core = {
    image        = "111111111111.dkr.ecr.eu-west-1.amazonaws.com/agrovesto/core:REPLACE_TAG"
    hostname     = "api"
    priority     = 100
    host_port    = 8080
    database_key = "core"
    memory_mb    = 512
  }
  auth = {
    image        = "111111111111.dkr.ecr.eu-west-1.amazonaws.com/agrovesto/auth:REPLACE_TAG"
    hostname     = "auth"
    priority     = 110
    host_port    = 8081
    database_key = "auth"
    memory_mb    = 512
  }
  trading = {
    image        = "111111111111.dkr.ecr.eu-west-1.amazonaws.com/agrovesto/trading:REPLACE_TAG"
    hostname     = "trading"
    priority     = 120
    host_port    = 8082
    database_key = "trading"
    memory_mb    = 512
  }
  catalog = {
    image        = "111111111111.dkr.ecr.eu-west-1.amazonaws.com/agrovesto/catalog:REPLACE_TAG"
    hostname     = "catalog"
    priority     = 130
    host_port    = 8083
    database_key = "catalog"
    memory_mb    = 512
  }
  notifications = {
    image        = "111111111111.dkr.ecr.eu-west-1.amazonaws.com/agrovesto/notifications:REPLACE_TAG"
    hostname     = "notifications"
    priority     = 140
    host_port    = 8084
    database_key = "notifications"
    memory_mb    = 512
  }
}

# Two Amplify static frontends (publish ZIPs with scripts/publish-amplify.sh)
frontends = {
  portal = {
    branch_name   = "dev"
    domain_prefix = "portal" # https://portal.dev.example.com
    spa           = true
    environment_variables = {
      NEXT_PUBLIC_API_BASE_URL = "https://api.dev.example.com"
    }
  }
  admin = {
    branch_name   = "dev"
    domain_prefix = "admin" # https://admin.dev.example.com
    spa           = true
    environment_variables = {
      NEXT_PUBLIC_API_BASE_URL = "https://api.dev.example.com"
    }
  }
}
