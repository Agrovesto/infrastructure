# EXAMPLES ONLY: first create two AWS accounts and bootstrap each one.
account_id               = "111111111111"
peer_account_id          = "222222222222"
aws_region               = "eu-west-1"
availability_zones       = ["eu-west-1a", "eu-west-1b"]
permissions_boundary_arn = "arn:aws:iam::111111111111:policy/agrovesto-bootstrap-dev-workload-boundary"
zone_name                = "dev.example.com"
alert_emails             = ["platform@example.com"]
monthly_budget_usd       = 200

# Explicitly accept Microsoft's EULA before changing this to true.
accept_sqlserver_eula = false
services_enabled      = false
instance_type         = "t3.large" # x86-64, 8 GiB. SQL gets 4 GiB; budget for APIs + OS.
root_volume_size      = 50         # OS, Docker and APIs
# Includes native .bak staging. Keep at least the largest DB's backup size free.
database_volume_size = 100

ecr_repositories = ["api", "web", "sql-admin"]
databases        = { api = "AgrovestoApi", trading = "AgrovestoTrading" }
services = {
  api = {
    image        = "111111111111.dkr.ecr.eu-west-1.amazonaws.com/agrovesto/api:REPLACE_WITH_COMMIT_SHA"
    port         = 8080
    host_port    = 8080
    hostname     = "api"
    priority     = 100
    health_path  = "/health"
    database_key = "api"
    environment  = { APP_ENV = "development" }
    # secrets = { JWT_SIGNING_KEY = "arn:aws:secretsmanager:eu-west-1:111111111111:secret:agrovesto/dev/jwt-ABC123" }
  }
  trading = {
    image        = "111111111111.dkr.ecr.eu-west-1.amazonaws.com/agrovesto/api:REPLACE_WITH_TRADING_COMMIT_SHA"
    host_port    = 8081
    hostname     = "trading"
    priority     = 200
    database_key = "trading"
  }
}
frontends = {
  portal = { branch_name = "dev", domain_prefix = "portal" }
  admin  = { branch_name = "dev", domain_prefix = "admin" }
}
# To reference a zone instead of managing/creating it:
# existing_zone_id = "Z0123456789EXAMPLE"
# Additional existing records must be explicitly declared AND imported:
# dns_records = { mail = { name = "dev.example.com", type = "MX", records = ["10 mail.example.com"] } }
