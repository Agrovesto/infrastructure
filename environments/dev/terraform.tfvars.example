aws_region  = "eu-west-1"
project     = "agrovesto"
domain_name = "agrovesto.dev"

# If the zone already exists in this account:
# create_hosted_zone = false
# existing_zone_id   = "ZXXXXXXXX"

allowed_ssh_cidrs = ["0.0.0.0/0"]
instance_type     = "t3.xlarge"
key_name          = "" # optional; SSM Session Manager is enabled

# GitHub PAT with repo scope (Amplify). Leave empty until you have it.
github_access_token = ""

# --- Frontends (Amplify). Add another block to create a 3rd app. ---
amplify_apps = {
  landing = {
    repository = "https://github.com/Agrovesto/landing"
    branch     = "main"
    subdomain  = "www"
    framework  = "React"
  }
  onboarding = {
    repository = "https://github.com/Agrovesto/onboarding"
    branch     = "main"
    subdomain  = "onboarding"
    framework  = "React"
  }
}

# --- Backends on Docker. Add another key to run a 6th API. ---
apis = {
  api-auth = {
    image     = "public.ecr.aws/nginx/nginx:alpine" # replace with real image
    host_port = 3001
    subdomain = "auth"
    env       = { NODE_ENV = "development" }
  }
  api-core = {
    image     = "public.ecr.aws/nginx/nginx:alpine"
    host_port = 3002
    subdomain = "api"
    env       = { NODE_ENV = "development" }
  }
  api-payments = {
    image     = "public.ecr.aws/nginx/nginx:alpine"
    host_port = 3003
    subdomain = "payments"
  }
  api-notifications = {
    image     = "public.ecr.aws/nginx/nginx:alpine"
    host_port = 3004
    subdomain = "notify"
  }
  api-analytics = {
    image     = "public.ecr.aws/nginx/nginx:alpine"
    host_port = 3005
    subdomain = "analytics"
  }
}

mssql_sa_password = "ChangeMe_Dev_P@ssw0rd1"
mssql_databases   = ["auth", "core", "payments", "notifications", "analytics"]

# Weekdays 08:00 start / 20:00 stop (Africa/Lagos)
scheduler_timezone   = "Africa/Lagos"
ec2_start_cron       = "cron(0 8 ? * MON-FRI *)"
ec2_stop_cron        = "cron(0 20 ? * MON-FRI *)"
enable_ec2_scheduler = true
