#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get upgrade -y -o Dpkg::Options::=--force-confold
apt-get install -y docker.io git xfsprogs curl
systemctl enable --now docker
usermod -aG docker ubuntu

# CloudWatch agent (installed only, matches previous behaviour — no config written)
curl -fsSL https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb -o /tmp/cw-agent.deb
dpkg -i /tmp/cw-agent.deb || apt-get install -f -y
rm -f /tmp/cw-agent.deb

# Docker Compose plugin
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Wait for MSSQL data volume and format if needed
DATA_DEV="${mssql_device}"
# NVMe mapping on nitro: /dev/sdf -> /dev/nvme1n1 typically
if [ ! -b "$DATA_DEV" ]; then
  DATA_DEV=/dev/nvme1n1
fi

for i in $(seq 1 30); do
  [ -b "$DATA_DEV" ] && break
  sleep 5
done

if ! blkid "$DATA_DEV"; then
  mkfs.xfs "$DATA_DEV"
fi

mkdir -p /data/mssql
UUID=$(blkid -s UUID -o value "$DATA_DEV")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /data/mssql xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
chown -R 10001:0 /data/mssql || true

mkdir -p /opt/agrovesto/{nginx,compose,vault,scripts}
cat >/opt/agrovesto/compose/.env <<'ENVEOF'
MSSQL_SA_PASSWORD=${sa_password}
BACKUP_BUCKET=${backup_bucket}
AWS_REGION=${aws_region}
ENVEOF
chmod 600 /opt/agrovesto/compose/.env

cat >/opt/agrovesto/compose/docker-compose.yml <<'COMPOSE'
${docker_compose}
COMPOSE

cat >/etc/nginx-agrovesto.conf <<'NGX'
${nginx_conf}
NGX
# nginx runs as a container; copy into compose volume
mkdir -p /opt/agrovesto/nginx/conf.d
cp /etc/nginx-agrovesto.conf /opt/agrovesto/nginx/nginx.conf

# init databases script
cat >/opt/agrovesto/scripts/init-dbs.sql <<'SQL'
${init_sql}
SQL

cat >/opt/agrovesto/scripts/init-mssql.sh <<'INIT'
#!/bin/bash
set -euo pipefail
export SA_PASSWORD="$${MSSQL_SA_PASSWORD}"
until /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "$SA_PASSWORD" -C -Q "SELECT 1" >/dev/null 2>&1; do
  sleep 5
done
/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "$SA_PASSWORD" -C -i /scripts/init-dbs.sql
INIT
chmod +x /opt/agrovesto/scripts/init-mssql.sh

# daily backup to S3
cat >/opt/agrovesto/scripts/backup-mssql.sh <<'BKP'
#!/bin/bash
set -euo pipefail
source /opt/agrovesto/compose/.env
STAMP=$(date +%Y%m%d-%H%M)
mkdir -p /data/mssql/backups
# Backup each DB via sqlcmd inside the mssql container
for db in ${db_list}; do
  docker exec agrovesto-mssql /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "$MSSQL_SA_PASSWORD" -C \
    -Q "BACKUP DATABASE [$db] TO DISK = N'/var/opt/mssql/backup/$db-$STAMP.bak' WITH COMPRESSION, INIT"
done
aws s3 sync /data/mssql/backup "s3://$BACKUP_BUCKET/mssql/$STAMP/" --region "$AWS_REGION"
find /data/mssql/backup -type f -mtime +3 -delete || true
BKP
chmod +x /opt/agrovesto/scripts/backup-mssql.sh
echo "0 2 * * * root /opt/agrovesto/scripts/backup-mssql.sh >> /var/log/mssql-backup.log 2>&1" > /etc/cron.d/mssql-backup

cd /opt/agrovesto/compose
# Authenticate to this account's ECR so compose can pull the agrovesto-dev-* API images
aws ecr get-login-password --region "${aws_region}" \
| docker login --username AWS --password-stdin "${ecr_registry}"
docker compose up -d

# wait then init DBs
sleep 40
docker exec agrovesto-mssql bash -c 'until /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "$MSSQL_SA_PASSWORD" -C -Q "SELECT 1" >/dev/null 2>&1; do sleep 5; done'
docker cp /opt/agrovesto/scripts/init-dbs.sql agrovesto-mssql:/tmp/init-dbs.sql
docker exec agrovesto-mssql /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "${sa_password}" -C -i /tmp/init-dbs.sql || true
