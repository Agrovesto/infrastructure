#!/bin/bash
# No initialization, seal migration, overwrite, or destructive formatting.
set -euo pipefail
exec 9>/run/agrovesto-vault-setup.lock
flock 9
fail() { echo "Vault setup refused: $*" >&2; exit 1; }
root=/data/vault
expected='${volume_serial}'
# Nitro device order is not stable. Resolve ONLY the exact EBS serial.
dev=""
for attempt in $(seq 1 60); do
  while read -r name serial; do
    if [ "$serial" = "$expected" ]; then dev="/dev/$name"; break; fi
  done < <(lsblk -dn -o NAME,SERIAL)
  [ -n "$dev" ] && break
  sleep 2
done
[ -b "$dev" ] || fail "expected EBS volume is not attached"
if ! mountpoint -q "$root"; then
  # Do not hide live Vault files, config, Dex, or other root-disk state.
  if [ -d "$root" ] && [ -n "$(find "$root" -mindepth 1 ! -type d -print -quit)" ]; then
    fail "existing root-disk files at $root require manual review"
  fi
  [ "$(docker inspect -f '{{.State.Running}}' agrovesto-vault 2>/dev/null || true)" != true ] || fail "stop Vault before first setup"
  [ "$(lsblk -nr -o NAME "$dev" | wc -l)" -eq 1 ] || fail "partitioned volume requires manual review"
  fs=$(blkid -s TYPE -o value "$dev" || true)
  if [ -z "$fs" ]; then
    [ -z "$(wipefs -n --noheadings -o TYPE "$dev")" ] || fail "unrecognized existing signature"
    mkfs.ext4 "$dev"
  elif [ "$fs" != ext4 ]; then
    fail "expected ext4, found $fs"
  fi
  mkdir -p "$root"
  uuid=$(blkid -s UUID -o value "$dev")
  if awk '$2 == "/data/vault" {found=1} END {exit !found}' /etc/fstab; then
    awk -v src="UUID=$uuid" '$2 == "/data/vault" && $1 == src {ok=1} END {exit !ok}' /etc/fstab || fail "conflicting fstab entry"
  else
    printf 'UUID=%s /data/vault ext4 defaults 0 2\n' "$uuid" >> /etc/fstab
  fi
  mount "$root"
fi
[ "$(findmnt -n -o MAJ:MIN -T "$root")" = "$(lsblk -dn -o MAJ:MIN "$dev")" ] || fail "wrong volume mounted"
mkdir -p "$root/config" "$root/data"
config="$root/config/vault.hcl"
source=/opt/agrovesto/vault/managed-vault.hcl
if [ -e "$config" ]; then
  [ -f "$config" ] && cmp -s "$source" "$config" || fail "existing config differs; explicit maintenance required"
else
  [ -z "$(find "$root/data" -mindepth 1 -print -quit)" ] || fail "data exists without config"
  install -m 0644 "$source" "$config"
fi
# Resolve the account from the configured image, rather than hardcoding its UID.
docker image inspect '${image}' >/dev/null 2>&1 || docker pull '${image}'
uid=$(docker run --rm --entrypoint id '${image}' -u vault)
gid=$(docker run --rm --entrypoint id '${image}' -g vault)
chown "$uid:$gid" "$root/data"
chmod 700 "$root/data"

# Mount the persistent disk before Docker can auto-restart any containers.
mkdir -p /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/vault-storage.conf <<'UNIT'
[Unit]
RequiresMountsFor=/data/vault
UNIT
# Upgrade existing hosts too: user_data changes alone are intentionally ignored.
mkdir -p /etc/systemd/system/agrovesto-sync.service.d
cat > /etc/systemd/system/agrovesto-sync.service.d/vault-storage.conf <<'UNIT'
[Service]
ExecStart=
ExecStart=/usr/local/bin/aws s3 sync s3://${bucket}/ /opt/agrovesto --region ${region} --only-show-errors
ExecStart=/bin/bash /opt/agrovesto/scripts/prepare-vault.sh
${oidc_exec}ExecStart=/usr/bin/docker compose --project-directory /opt/agrovesto/compose -f /opt/agrovesto/compose/docker-compose.yml up -d --remove-orphans
ExecStart=/bin/bash /opt/agrovesto/scripts/connect-vault-network.sh
UNIT
systemctl daemon-reload
