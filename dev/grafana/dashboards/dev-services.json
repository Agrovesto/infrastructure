          "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$container\"}[5m])) / (max by (name) (container_spec_cpu_quota{name=~\"$container\"} > 0) / max by (name) (container_spec_cpu_period{name=~\"$container\"}))",
