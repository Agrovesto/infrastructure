{
  "uid": "agrovesto-dev-services",
  "title": "Agrovesto dev \u2014 apps & services",
  "description": "cAdvisor's view of every container on the dev box: CPU against the host and against each container's own limit, memory against its limit, restarts, OOM kills, network and disk. The observability containers are kept out of the app panels so a busy Loki cannot hide a busy API. Host-wide numbers live on the host & containers dashboard, the box itself on the infrastructure dashboard.",
  "tags": [
    "agrovesto",
    "dev",
    "containers",
    "capacity"
  ],
  "timezone": "Africa/Lagos",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "agrovesto-prom"
        },
        "query": "label_values(container_last_seen{name=~\"agrovesto-.+\"}, name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": "agrovesto-.+",
        "regex": "",
        "sort": 1,
        "options": [],
        "definition": "label_values(container_last_seen{name=~\"agrovesto-.+\"}, name)",
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Headline",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Containers running",
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "count(container_last_seen{name=~\"agrovesto-.+\"})",
          "legendFormat": "containers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Busiest container",
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "topk(1, sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"agrovesto-.+\"}[5m])) * 100)",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "description": "CPU as a percentage of one core.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Highest memory use",
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "topk(1, container_memory_working_set_bytes{name=~\"agrovesto-.+\"} / on(id, name) group_left container_spec_memory_limit_bytes{name=~\"agrovesto-.+\"} * 100)",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
