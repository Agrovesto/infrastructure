{
  "uid": "agrovesto-dev-host",
  "title": "Agrovesto dev \u2014 host & containers",
  "description": "node_exporter for the box, cAdvisor for every container, plus the self-reported metrics of Loki, Alloy, Grafana and Prometheus.",
  "tags": [
    "agrovesto",
    "dev",
    "prometheus",
    "capacity"
  ],
  "timezone": "Africa/Lagos",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "CPU used",
      "description": "All containers share these 2 vCPU.",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "cpu %"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memory used",
      "description": "",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "mem %"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Root disk used",
      "description": "OS + docker images + the json-file logs docker rotates for you.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}))",
          "legendFormat": "disk %"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Logging volume used",
      "description": "Loki chunks + the Prometheus TSDB on their own gp3 volume. This is the number that decides how long retention can stay.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/opt/agrovesto/logging\"} / node_filesystem_size_bytes{mountpoint=\"/opt/agrovesto/logging\"}))",
          "legendFormat": "logs %"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU per container",
      "description": "Percent of one core. cAdvisor reports every container, including the observability ones, so the cost of the stack itself is visible here.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "thresholdsMode": "off",
            "gradientMode": "opacity",
            "stacking": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[2m])) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory vs each container's own limit",
      "description": "A container sitting at ~100% is one allocation away from being OOM-killed.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "thresholdsMode": "off",
            "gradientMode": "opacity",
            "stacking": "none"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "container_memory_working_set_bytes{name!=\"\"} / on(id, name) group_left container_spec_memory_limit_bytes{name!=\"\"} * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk IO",
      "description": "SQL Server and Loki are both write-heavy: contention shows up here first.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "thresholdsMode": "off",
            "gradientMode": "opacity",
            "stacking": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "sum(rate(node_disk_read_bytes_total[2m]))",
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "sum(rate(node_disk_written_bytes_total[2m]))",
          "legendFormat": "write"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network per container",
      "description": "",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "agrovesto-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "thresholdsMode": "off",
            "gradientMode": "opacity",
            "stacking": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name!=\"\"}[2m]))",
          "legendFormat": "in {{name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "agrovesto-prom"
          },
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name!=\"\"}[2m]))",
          "legendFormat": "out {{name}}"
