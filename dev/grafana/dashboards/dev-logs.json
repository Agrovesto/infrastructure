    {
      "type": "timeseries",
      "title": "Log rate by service",
      "description": "Lines per second per container. Alloy tails docker's own json-file logs, so no logging driver has to change in the app containers.",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "agrovesto-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "thresholdsMode": "off",
            "gradientMode": "opacity",
            "stacking": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "agrovesto-loki"
          },
          "expr": "sum by (service) (rate({job=\"docker\", service=~\"$service\"} [$__auto]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors and warnings by service",
      "description": "The level label comes from the ASP.NET Core console prefix (info:/warn:/fail:/crit:) or from the level field of a JSON log line.",
