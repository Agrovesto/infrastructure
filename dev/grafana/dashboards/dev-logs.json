{
  "uid": "agrovesto-dev-logs",
  "title": "Agrovesto dev \u2014 logs",
  "description": "Application, nginx and journald logs from the dev EC2 host. Tailed by Alloy, stored in Loki; both run on this box.",
  "tags": [
    "agrovesto",
    "dev",
    "loki",
    "logs"
  ],
  "timezone": "Africa/Lagos",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "agrovesto-loki"
        },
        "query": {
          "type": 1,
          "label": "service",
          "stream": "{job=\"docker\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "options": []
      },
      {
        "name": "level",
      "label": "Level",
      "type": "custom",
      "description": "Matches the promoted Loki level label (anchored regex), so errors-only views are filtered in the index instead of per line. Add ad-hoc line filters to the panel query, e.g. |~ \"(?i)timeout\".",
        "query": ".*,(?i)(fail|crit|error),(?i)(warn|fail|crit|error)",
        "current": {
          "text": "everything",
          "value": ".*"
        },
        "options": [
          {
            "text": "everything",
            "value": ".*",
            "selected": true
          },
          {
            "text": "errors only",
            "value": "(?i)(fail|crit|error)",
            "selected": false
          },
          {
            "text": "warn and above",
            "value": "(?i)(warn|fail|crit|error)",
            "selected": false
          }
        ],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "App log lines (15 min)",
      "description": "",
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "agrovesto-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "agrovesto-loki"
          },
          "expr": "sum(count_over_time({job=\"docker\"} [15m]))",
          "legendFormat": "lines",
          "queryType": "range"
        }
      ]
    },
