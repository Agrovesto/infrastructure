          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "agrovesto-loki"
          },
          "expr": "quantile_over_time(0.5, {component=\"nginx\"} | json | unwrap request_time | __error__=\"\" [$__auto])",
          "legendFormat": "median",
          "queryType": "range"
        }
