{
  "uid": "agrovesto-dev-traffic",
  "title": "Agrovesto dev \u2014 traffic & clients",
  "description": "nginx writes one JSON line per request (log_format agrovesto_json in dev/nginx.conf.tftpl) and Alloy tails it into Loki. Only component, level, status and method are labels; the vhost, URI, client IP and user agent stay in the line and are read out at query time with | json. nginx restores the client address from X-Forwarded-For for the trusted TLS proxy, so remote_addr is the real client and each API is its own vhost.",
  "tags": [
    "agrovesto",
    "dev",
    "nginx",
    "traffic",
    "loki"
  ],
  "timezone": "Africa/Lagos",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "status",
        "label": "Status",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "agrovesto-loki"
        },
        "query": {
          "type": 1,
          "label": "status",
          "stream": "{component=\"nginx\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Volume",
