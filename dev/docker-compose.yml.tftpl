services:
  nginx:
    image: nginx:1.27-alpine
    container_name: agrovesto-nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/agrovesto/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
    restart: unless-stopped
    depends_on:
%{ for name, api in apis ~}
      - ${name}
%{ endfor ~}
      - vault

%{ for name, api in apis ~}
  ${name}:
    image: ${api.image}
    container_name: agrovesto-${name}
    ports:
      - "127.0.0.1:${api.host_port}:${api.host_port}"
    environment:
%{ for k, v in api.env ~}
      ${k}: "${v}"
%{ endfor ~}
    restart: unless-stopped

%{ endfor ~}
  mssql:
    image: ${mssql.image}
    container_name: agrovesto-mssql
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_SA_PASSWORD: "$${MSSQL_SA_PASSWORD}"
      MSSQL_PID: "${mssql.pid}"
    ports:
      - "127.0.0.1:${mssql.host_port}:1433"
    volumes:
      - /data/mssql:/var/opt/mssql
    restart: unless-stopped

  vault:
    image: ${vault.image}
    container_name: agrovesto-vault
    cap_add:
      - IPC_LOCK
    environment:
      VAULT_DEV_ROOT_TOKEN_ID: "dev-root-token"
      VAULT_DEV_LISTEN_ADDRESS: "0.0.0.0:8200"
      VAULT_ADDR: "http://127.0.0.1:8200"
    ports:
      - "127.0.0.1:${vault.host_port}:8200"
    command: server -dev
    restart: unless-stopped
