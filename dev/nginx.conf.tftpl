# =============================================================================
# nginx for the dev EC2 host — rendered by Terraform (dev/locals.tf)
#
# One server block per subdomain, all proxying to containers on the compose
# network. Uploaded as nginx/nginx.conf in the host config bucket and synced to
# /opt/agrovesto/nginx/nginx.conf at boot; edit the template, not the file.
#
# Log lines go to stdout on purpose: they land in the container's json-file log,
# which Alloy tails along with the apps', so `nginx` is just another stream in
# Loki (see dev/alloy-config.alloy.tftpl).
# =============================================================================
events {
  worker_connections 1024;
}

http {
  resolver 127.0.0.11 valid=10s ipv6=off;

  # When the Caddy TLS edge runs (GitHub SSO, Vault OIDC, or an API vhost with
  # apis.<name>.tls_via_caddy), Caddy terminates TLS and forwards to this
  # container over the private compose network. Trust proxy headers only from
  # RFC1918 addresses so a direct internet client cannot spoof its source IP
  # and bypass the Grafana/SonarQube/Vault allow lists below.
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  # Preserve the browser-facing scheme after TLS termination. Only a private
  # compose-network peer may supply it; a direct client-provided header is
  # ignored. $realip_remote_addr retains Caddy's address after $remote_addr is
  # restored to the browser address by the real-ip module above.
  geo $realip_remote_addr $trusted_reverse_proxy {
    default        0;
    10.0.0.0/8     1;
    172.16.0.0/12  1;
    192.168.0.0/16 1;
  }

  map "$trusted_reverse_proxy:$http_x_forwarded_proto" $forwarded_proto {
    default          $scheme;
    ~^1:(https?)$    $1;
  }

  # One JSON object per request, so the access log is queryable instead of
  # grep fodder: status/uri/method/request_time become Loki labels or filters.
  log_format agrovesto_json escape=json
    '{"ts":"$time_iso8601",'
    '"component":"nginx",'
    '"level":"info",'
    '"host":"$host",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":"$status",'
    '"upstream_status":"$upstream_status",'
    '"upstream_addr":"$upstream_addr",'
    '"request_time":"$request_time",'
    '"upstream_response_time":"$upstream_response_time",'
    '"body_bytes":"$body_bytes_sent",'
    '"remote_addr":"$remote_addr",'
    '"http_user_agent":"$http_user_agent"}';

  access_log /var/log/nginx/access.log agrovesto_json;
  error_log  /var/log/nginx/error.log  warn;

  # Grafana opens websockets (live streaming, alerting); everything else is
  # ordinary request/response.
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

%{ for u in upstreams ~}
  server {
    listen 80;
    server_name ${u.subdomain}.${domain};

    location / {
      proxy_pass http://${u.name}:${u.port};
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
  }

%{ endfor ~}
  # ── Vault: dev-mode secrets UI/API ──────────────────────────────────────────
  # Before OIDC this remains internal even if DNS points here: do not send
  # Vault tokens over public HTTP. With OIDC enabled, Caddy owns public 80/443
  # and enforces HTTPS before proxying to nginx (and serves Dex at /dex).
  server {
    listen 80;
    server_name ${vault.subdomain}.${domain};

%{ if vault.oidc_enabled ~}
    # Caddy owns public 80/443 and enforces HTTPS for this host. This nginx
    # server is reachable only on the private Compose network in OIDC mode.
    allow all;
%{ else ~}
    allow 127.0.0.1;
    allow 172.16.0.0/12;
    deny all;
%{ endif ~}

    location / {
      # Resolve at request time so a Vault container restart does not leave
      # nginx pinned to a stale Docker IP.
      set $vault_backend vault:8200;
      proxy_pass http://$vault_backend;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }

%{ if grafana.enabled ~}
  # ── Grafana: the logging UI ───────────────────────────────────────────────
  # Served here so there is one open port on the box, but gated by source IP:
  # `logging.allowed_cidrs` becomes the allow list below and everything else is
  # denied at the edge. With an empty allow list this vhost answers 127.0.0.1
  # only, i.e. it is reachable through an SSH tunnel and nobody else.
  # Grafana's own login is the second gate; Loki and Prometheus are never
  # proxied — they publish loopback ports and Grafana talks to them over the
  # compose network.
  server {
    listen 80;
    server_name ${grafana.subdomain}.${domain};

%{ for cidr in grafana.cidrs ~}
    allow ${cidr};
%{ endfor ~}
    deny all;

    location / {
      proxy_pass http://grafana:${grafana.port};  # the container port, not the published one
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      # A LogQL query over a week of logs is not fast; do not kill it at 60s.
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;
      client_max_body_size 10m;
    }
  }

%{ endif ~}
%{ if sonar.enabled ~}
  # ── SonarQube: the code-quality UI and the scanner endpoint ───────────────
  # Same shape as the Grafana vhost above — one open port on the box, gated by
  # source IP, with the application's own login behind it — with one difference
  # that matters: this vhost is also where the CI scanner POSTs its reports, so
  # `sonarqube.allowed_cidrs` has to admit the runners as well as the humans.
  # GitHub-hosted runner addresses are not a fixed set, so the workable options
  # are a self-hosted runner inside the allow list, an allowlisted NAT egress, or
  # (not recommended) 0.0.0.0/0 with SonarQube's own auth as the only gate.
  #
  # nginx still listens on the private HTTP hop. When GitHub SSO is configured,
  # Caddy owns public ports 80/443, obtains the certificate and forwards this
  # vhost with X-Forwarded-Proto=https. The allow list below therefore remains
  # the authorization edge for both direct HTTP and TLS-proxied requests.
  server {
    listen 80;
    server_name ${sonar.subdomain}.${domain};

%{ for cidr in sonar.cidrs ~}
    allow ${cidr};
%{ endfor ~}
    deny all;

    location / {
      proxy_pass http://sonarqube:${sonar.port};  # the container port, not the published one
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      # A report upload is a multi-megabyte POST and the compute engine then
      # spends minutes processing it. The 60s/1m defaults cut both off mid-flight,
      # which surfaces as a scanner timeout rather than an nginx error.
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      proxy_connect_timeout 60s;
      client_max_body_size 100m;
    }
  }

%{ endif ~}
  server {
    listen 80 default_server;
    server_name _;
    return 404;
  }
}
