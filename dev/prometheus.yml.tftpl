# =============================================================================
# Prometheus — host and container metrics on the dev EC2 host
#
# Rendered by Terraform (dev/locals.tf), uploaded as the object
# logging/prometheus/prometheus.yml in the host config bucket
# (dev/host_config.tf) and synced by user_data to
# /opt/agrovesto/logging/prometheus/prometheus.yml on every boot.
#
# Do not edit on the host: the next boot re-syncs the Terraform copy over it.
# Iterate there instead - `docker compose restart prometheus` after editing the
# file makes a change visible without a Terraform run, and apply makes it final.
#
#
# Nine scrape targets, all on the docker network. There is no service
# discovery: this is a single box, the TSDB on the logging volume is the store,
# and the remote-write receiver (enabled in docker-compose) is what Tempo's
# span metrics and Alloy's OTLP metrics arrive on.
# =============================================================================

global:
  scrape_interval: ${scrape_interval}s
  scrape_timeout: 10s
  evaluation_interval: 60s
  external_labels:
    stack: ${project}-${environment}
    host: ${hostname}

# Alert rules (prometheus-rules.yml.tftpl) -> Alertmanager -> SNS alerts topic.
rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:${alertmanager_port}"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # CPU, memory, disk, load, filesystem — the box itself.
  - job_name: node
    static_configs:
      - targets: ["node-exporter:${node_exporter_port}"]

  # Per-container CPU / memory / network, from the cgroup of each container
  # including the six observability ones. This is what answers "did wallet or
  # mssql eat the box".
  - job_name: cadvisor
    static_configs:
      - targets: ["cadvisor:${cadvisor_port}"]

  # Loki, Alloy and Tempo report their own ingest, drop, query and compaction
  # counters here, so "are my logs/traces still flowing" is a graph and not a
  # guess. Tempo's span metrics arrive by remote write, not by scrape.
  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]

  - job_name: tempo
    static_configs:
      - targets: ["tempo:${tempo_port}"]

  - job_name: alloy
    static_configs:
      - targets: ["alloy:${metrics_port}"]

  - job_name: grafana
    static_configs:
      - targets: ["grafana:${grafana_port}"]

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:${alertmanager_port}"]

  # SQL Server DMVs: the mssql-exporter container re-runs the queries on every
  # scrape (serve mode of the script the prod monitoring task pushes from), so
  # these series are as fresh as everything else on this box.
  - job_name: mssql
    static_configs:
      - targets: ["mssql-exporter:${mssql_exporter_port}"]
