#!/usr/bin/env bash
# Write one service's JSON object to its KV v2 path without placing values in
# shell history, process arguments, Terraform state, or S3.
set -Eeuo pipefail
umask 077

readonly path_environment="${path_environment}"
readonly kv_mount="${kv_mount}"
readonly vault_container="agrovesto-vault"

services=(
%{ for service in services ~}
  "${service}"
%{ endfor ~}
)

fail() { printf 'Vault secret write refused: %s\n' "$1" >&2; exit 1; }

if [[ "$${EUID}" -ne 0 ]]; then
  fail "run as root through an approved administrative session"
fi
[[ "$${#}" -eq 2 ]] || fail "usage: $0 <service> <private-json-file>"
service="$1"
secret_file="$2"
known=false
for candidate in "$${services[@]}"; do
  if [[ "$candidate" == "$service" ]]; then known=true; break; fi
done
[[ "$known" == true ]] || fail "unknown service '$service'"
[[ -f "$secret_file" && ! -L "$secret_file" && -r "$secret_file" ]] || fail "the JSON input must be a readable regular file, not a symlink"

file_mode="$(stat -c '%a' -- "$secret_file")"
[[ "$file_mode" =~ ^[0-7]{3,4}$ ]] || fail "could not verify JSON file permissions"
mode_value=$((8#$file_mode))
(( (mode_value & 077) == 0 )) || fail "the JSON input must not be readable or writable by group/other; use mode 0600"

if [[ -z "$${VAULT_TOKEN:-}" ]]; then
  [[ -r /dev/tty ]] || fail "set VAULT_TOKEN through a secure administrative session"
  read -r -s -p "Vault administrator token: " VAULT_TOKEN </dev/tty
  printf '\n' >/dev/tty
fi
[[ -n "$${VAULT_TOKEN:-}" ]] || fail "an administrator token is required"
export VAULT_TOKEN

command -v docker >/dev/null || fail "Docker is not installed"
command -v python3 >/dev/null || fail "python3 is required"
[[ "$(docker inspect -f '{{.State.Running}}' "$vault_container" 2>/dev/null || true)" == true ]] || fail "the Vault container is not running"

secret_api_path="${kv_mount}/data/$service/${path_environment}/appsettings"

# The values travel only through stdin. Vault's write response is suppressed so
# neither secret values nor a response body can be accidentally copied to logs.
python3 - "$secret_file" <<'PY' | docker exec -i -e VAULT_TOKEN "$vault_container" vault write -format=json "$secret_api_path" - >/dev/null
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as secret_file:
        values = json.load(secret_file)
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"invalid service-secret JSON: {exc.__class__.__name__}")
if not isinstance(values, dict) or not values:
    raise SystemExit("service secrets must be a non-empty JSON object")
if not all(isinstance(key, str) and key for key in values):
    raise SystemExit("service secret keys must be non-empty strings")
print(json.dumps({"data": values}, separators=(",", ":")))
PY

unset VAULT_TOKEN
printf 'Wrote KV v2 data for service %s at %s/%s/%s/appsettings; values were not printed.\n' \
  "$service" "$kv_mount" "$service" "$path_environment"
