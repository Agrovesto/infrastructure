{
  # Caddy obtains and renews public certificates automatically. Its /data and
  # /config directories are mounted from a persistent encrypted EBS volume.
  email ${email}
  admin off

  # Only the hosts in the HTTPS site below move to HTTPS: the SSO UIs, the Vault
  # host when Vault OIDC is enabled (Dex serves at its /dex path) and API vhosts
  # that opt in with apis.<name>.tls_via_caddy. The other dev API vhosts retain
  # their current HTTP behaviour through the catch-all below.
  auto_https disable_redirects
}

:80 {
  @tls_hosts host ${join(" ", domains)}
  redir @tls_hosts https://{host}{uri} 308

  reverse_proxy nginx:80
}

${join(", ", domains)} {
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

%{ if vault_oidc_enabled ~}
  # Dex is Vault's GitHub browser-login broker (GitHub OAuth -> Dex -> Vault
  # OIDC, see docs/vault-github-login.md) and belongs to the Vault OIDC
  # feature: its /dex paths at the canonical issuer URL
  # https://${vault_domain}/dex/ go straight to Dex — the one upstream proxied
  # directly instead of through nginx, which has no vhost for it. Everything
  # else stays behind nginx, the application router and source-IP
  # authorization edge.
  @dex {
    host ${vault_domain}
    path /dex /dex/*
  }
  handle @dex {
    reverse_proxy dex:5556
  }
  handle {
    reverse_proxy nginx:80
  }
%{ else ~}
  # nginx remains the application router and source-IP authorization edge.
  reverse_proxy nginx:80
%{ endif ~}
}
