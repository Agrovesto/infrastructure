{
  # Caddy obtains and renews public certificates automatically. Its /data and
  # /config directories are mounted from a persistent encrypted EBS volume.
  email ${email}
  admin off

  # Only the hosts in the HTTPS site below move to HTTPS: the SSO UIs, the Vault
  # host (Dex serves at its /dex path) and API vhosts that opt in with
  # apis.<name>.tls_via_caddy. The other dev API vhosts retain their current
  # HTTP behaviour through the catch-all below.
  auto_https disable_redirects
}

:80 {
  @tls_hosts host ${join(" ", domains)}
  redir @tls_hosts https://{host}{uri} 308

  reverse_proxy nginx:80
}

${join(", ", domains)} {
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  # Dex (GitHub OAuth -> OIDC) is the one upstream proxied directly instead of
  # through nginx: it has no nginx vhost and serves nothing but these paths. The
  # route is a standing part of the TLS edge — it answers at the canonical
  # issuer URL https://${vault_domain}/dex/ as soon as Dex is deployed (Vault
  # OIDC enablement) and returns 502 on /dex alone until then. Everything else
  # stays behind nginx, the application router and source-IP authorization edge.
  @dex {
    host ${vault_domain}
    path /dex /dex/*
  }
  handle @dex {
    reverse_proxy dex:5556
  }
  handle {
    reverse_proxy nginx:80
  }
}
