.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
terraform.tfvars
.terraform.lock.hcl
tfplan
tfplan.txt
tfplan*

# CI artifacts (written by the Terraform Test & Coverage job)
test-results.json
test-stderr.log
coverage.json
coverage.md

# Python bytecode from scripts/
__pycache__/
*.pyc

# Infracost local cost runs (scripts/infracost.sh)
.infracost/

# SonarScanner working directory (local/CI scanner state, never committed)
.scannerwork/

# AWS discovery scans (scripts/aws-inventory-scan.sh).
# These hold account IDs, IP addresses, ARNs and internal hostnames, and this
# repo is public - so scan output stays local. To keep one curated snapshot in
# git anyway:  git add -f dev/discovery/SUMMARY.md
# ...with two exceptions, so a curated import package can be reviewed in a PR:
# the triage write-up and the generated import blocks. Everything else in a
# discovery folder (raw API responses, full inventories, CSVs) stays local.
dev/discovery/*
prod/discovery/*
monitoring/discovery/*
.discovery/
!dev/discovery/TRIAGE.md
!prod/discovery/TRIAGE.md
!monitoring/discovery/TRIAGE.md
!dev/discovery/imports/
!prod/discovery/imports/
!monitoring/discovery/imports/
