# Terraform state, private inputs, plans and downloaded providers
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
*.tfvars
*.tfvars.json
*.auto.tfvars.json
backend.hcl
backend.*.hcl
!*.example
crash.log
crash.*.log
terraform.rc
.terraformrc
# Keep .terraform.lock.hcl files in Git.
.env
.env.*
!.env.example
# Local Compose secrets (keep *.env.example)
compose/**/env/*.env
!compose/**/env/*.env.example
*.pem
*.key
*.pfx
*.bak
*.trn
*.zip
*.tar
*.tar.gz
