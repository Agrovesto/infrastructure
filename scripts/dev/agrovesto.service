[Unit]
Description=Agrovesto Docker Compose APIs and SQL Server
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/srv/mssql

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
WorkingDirectory=/opt/agrovesto
ExecStart=/opt/agrovesto/start.sh
ExecStop=/usr/bin/docker compose -f /opt/agrovesto/compose.yaml stop
TimeoutStartSec=1200
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
