   "title": "Distinct client IPs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(sum by (client_ip) (count_over_time({source=\"alb\", kind=\"request\", service=~\"$service\"} | json [$__range])))",
     "legendFormat": "clients",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 15,
    "y": 1
   }
  },
