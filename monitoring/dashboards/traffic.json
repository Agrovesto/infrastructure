{
 "uid": "agrovesto-traffic",
 "title": "Traffic: requests, status and clients",
 "description": "Every request the prod load balancer accepted. The collector parses the ALB access logs out of S3 and ships them to Loki as JSON lines (monitoring/scripts/alb_logs.py), so volume, status, latency, client IP, URI and user agent are queryable here. Health-check requests are shipped too but tagged kind=\"health\" and left out of the client panels.",
 "tags": [
  "agrovesto",
  "alb",
  "traffic",
  "loki"
 ],
 "timezone": "browser",
 "refresh": "5m",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "type": 1,
     "label": "service",
     "stream": "{source=\"alb\"}",
     "refId": "LokiVariableQueryEditor-VariableQuery"
    },
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "refresh": 2,
    "regex": "",
    "sort": 1,
    "options": []
   },
   {
    "name": "status",
    "label": "Status",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "type": 1,
     "label": "status",
     "stream": "{source=\"alb\"}",
     "refId": "LokiVariableQueryEditor-VariableQuery"
    },
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "refresh": 2,
    "regex": "",
    "sort": 1,
    "options": []
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Volume",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Requests (range)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({source=\"alb\", kind=\"request\", service=~\"$service\"}[$__range]))",
     "legendFormat": "requests",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 0,
    "y": 1
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Requests (24h)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({source=\"alb\", kind=\"request\"}[24h]))",
     "legendFormat": "requests",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 3,
    "y": 1
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "5xx (range)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({source=\"alb\", kind=\"request\", status=~\"5..\", service=~\"$service\"}[$__range]))",
     "legendFormat": "5xx",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 6,
    "y": 1
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "4xx (range)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({source=\"alb\", kind=\"request\", status=~\"4..\", service=~\"$service\"}[$__range]))",
     "legendFormat": "4xx",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 9,
    "y": 1
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Error rate",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(count_over_time({source=\"alb\", kind=\"request\", status=~\"[45]..\", service=~\"$service\"}[$__range])) / sum(count_over_time({source=\"alb\", kind=\"request\", service=~\"$service\"}[$__range]))",
     "legendFormat": "% 4xx+5xx",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 2
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 12,
    "y": 1
   }
  },
  {
   "id": 7,
