   "title": "p95 target latency",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "quantile_over_time(0.95, {source=\"alb\", kind=\"request\", service=~\"$service\"} | json | target_response_time != \"-\" | unwrap target_response_time | __error__=\"\" [$__range])",
     "legendFormat": "p95",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
