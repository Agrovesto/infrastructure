{
 "uid": "agrovesto-database",
 "title": "Database: per-database SQL Server deep dive",
 "description": "Every database on the prod SQL Server (RDS Express, the same five as dev plus system DBs): size against the 10 GB per-database cap, log headroom, sessions, transactions, deadlocks, autogrowth and read/write I/O with latency; a Performance-Insights-style workload row (active sessions, load by wait type, sessions per login \u2014 PI itself does not exist for Express); the server's health; and live DMV queries through the MSSQL datasource for what is running, who is connected, blocking chains and the top statements right now. Trends come from the hourly DMV task (monitoring/rds.tf) via Pushgateway \u2014 rate/increase panels use 2h windows because values arrive once an hour. The summary stats also live on the Services dashboard.",
 "tags": [
  "agrovesto",
  "database",
  "mssql",
  "rds"
 ],
 "timezone": "browser",
 "refresh": "1m",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "db",
    "label": "Database",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(mssql_database_size_bytes, db)",
    "includeAll": true,
    "multi": true,
    "refresh": 2
   },
   {
    "name": "livedb",
    "label": "Live SQL database",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(mssql_database_size_bytes, db)",
    "includeAll": false,
    "multi": false,
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Per database (SQL Server Express: each database caps at 10 GB, data + log)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Database size",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mssql_database_size_bytes{db=~\"$db\"}",
     "legendFormat": "{{db}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "axisPlacement": "auto",
      "thresholdsStyle": {
       "mode": "line+area"
      },
      "gradientMode": "none",
      "stacking": "none"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 8589934592
       },
       {
        "color": "red",
        "value": 10737418240
       }
      ]
     },
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "description": "Data + log per database (sys.master_files). The yellow line is the 8 GiB alert threshold (MssqlDatabaseNearSizeLimit), the red line the hard Express cap: writes fail at 10 GB.",
   "id": 2
  },
