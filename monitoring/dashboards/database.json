  {
   "type": "table",
   "title": "Top tables in $livedb",
   "datasource": {
    "type": "mssql",
    "uid": "mssql"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mssql",
      "uid": "mssql"
     },
     "rawSql": "SELECT TOP 25\n  s.name AS schema_name,\n  o.name AS object_name,\n  SUM(a.total_pages) * 8 / 1024 AS size_mb,\n  SUM(CASE WHEN a.type IN (1, 3) THEN a.total_pages ELSE 0 END) * 8 / 1024 AS data_mb,\n  SUM(CASE WHEN a.type = 2 THEN a.total_pages ELSE 0 END) * 8 / 1024 AS index_mb\nFROM [$livedb].sys.partitions p\nJOIN [$livedb].sys.allocation_units a ON a.container_id = p.partition_id\nJOIN [$livedb].sys.objects o ON o.object_id = p.object_id\nJOIN [$livedb].sys.schemas s ON s.schema_id = o.schema_id\nWHERE p.index_id IN (0, 1) AND o.is_ms_shipped = 0\nGROUP BY s.name, o.name\nORDER BY size_mb DESC",
     "format": "table"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
