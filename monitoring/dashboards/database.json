  {
   "type": "table",
   "title": "Running requests",
   "datasource": {
    "type": "mssql",
    "uid": "mssql"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mssql",
      "uid": "mssql"
     },
     "rawSql": "SELECT TOP 50\n  r.session_id,\n  DB_NAME(r.database_id) AS db,\n  s.login_name,\n  s.host_name,\n  r.status,\n  r.command,\n  r.wait_type,\n  r.wait_time / 1000 AS wait_s,\n  r.blocking_session_id AS blocked_by,\n  r.cpu_time,\n  r.logical_reads,\n  r.total_elapsed_time / 1000 AS elapsed_s,\n  SUBSTRING(t.text, (r.statement_start_offset / 2) + 1,\n    ((CASE r.statement_end_offset WHEN -1 THEN DATALENGTH(t.text) ELSE r.statement_end_offset END\n      - r.statement_start_offset) / 2) + 1) AS statement_text\nFROM sys.dm_exec_requests r\nJOIN sys.dm_exec_sessions s ON s.session_id = r.session_id\nCROSS APPLY sys.dm_exec_sql_text(r.sql_handle) t\nWHERE r.session_id <> @@SPID AND s.is_user_process = 1\nORDER BY r.total_elapsed_time DESC",
     "format": "table"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "enablePagination": false,
     "fields": ""
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 65
   },
   "description": "What is executing right now (sys.dm_exec_requests + statement text), most elapsed time first. This dashboard's own queries are excluded.",
   "id": 27
  },
  {
   "type": "table",
   "title": "Connections \u2014 who is connected",
   "datasource": {
    "type": "mssql",
    "uid": "mssql"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mssql",
      "uid": "mssql"
     },
     "rawSql": "SELECT TOP 100\n  s.session_id,\n  DB_NAME(s.database_id) AS db,\n  s.login_name,\n  s.host_name,\n  s.program_name,\n  c.client_net_address AS client_ip,\n  s.status,\n  CAST(s.last_request_start_time AS varchar(23)) AS last_request_start,\n  s.cpu_time,\n  s.reads,\n  s.writes,\n  s.logical_reads,\n  s.memory_usage * 8 AS memory_kb\nFROM sys.dm_exec_sessions s\nLEFT JOIN sys.dm_exec_connections c ON c.session_id = s.session_id\nWHERE s.is_user_process = 1\nORDER BY s.last_request_start_time DESC",
     "format": "table"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "enablePagination": false,
     "fields": ""
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 74
   },
   "description": "Every user session with its login, client machine, program, client IP, current database and the cost it has run up. Failed logins never appear here \u2014 they are in the SQL Server error log (dev: the mssql container's logs in dev-logs; prod: the CloudWatch error-log export).",
   "id": 28
  },
  {
   "type": "table",
   "title": "Blocking chains",
   "datasource": {
    "type": "mssql",
    "uid": "mssql"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mssql",
      "uid": "mssql"
     },
     "rawSql": "SELECT\n  r.session_id AS blocked_session,\n  DB_NAME(r.database_id) AS db,\n  r.blocking_session_id AS blocker,\n  r.wait_type,\n  r.wait_time / 1000 AS wait_s,\n  t.text AS blocked_statement,\n  tb.text AS blocker_statement\nFROM sys.dm_exec_requests r\nOUTER APPLY sys.dm_exec_sql_text(r.sql_handle) t\nLEFT JOIN sys.dm_exec_requests rb ON rb.session_id = r.blocking_session_id\nOUTER APPLY sys.dm_exec_sql_text(rb.sql_handle) tb\nWHERE r.blocking_session_id <> 0\nORDER BY r.wait_time DESC",
     "format": "table"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "enablePagination": false,
     "fields": ""
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 83
   },
   "description": "Every blocked request with its blocker's last statement \u2014 who to kill or which query to fix.",
   "id": 29
  },
  {
   "type": "table",
   "title": "Database files",
   "datasource": {
    "type": "mssql",
    "uid": "mssql"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
