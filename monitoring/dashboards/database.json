     "rawSql": "SELECT\n  DB_NAME(database_id) AS db,\n  name AS logical_name,\n  type_desc,\n  CAST(size * 8.0 / 1024 AS DECIMAL(18, 1)) AS size_mb,\n  CASE WHEN is_percent_growth = 1\n       THEN CAST(growth AS VARCHAR(10)) + '%'\n       ELSE CAST(growth * 8 / 1024 AS VARCHAR(10)) + ' MB' END AS growth,\n  state_desc,\n  physical_name\nFROM sys.master_files\nORDER BY database_id, type_desc",
