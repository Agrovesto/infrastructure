  {
   "type": "table",
   "title": "Top queries by total time",
   "datasource": {
    "type": "mssql",
    "uid": "mssql"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mssql",
      "uid": "mssql"
     },
     "rawSql": "SELECT TOP 25\n  qs.execution_count AS execs,\n  qs.total_elapsed_time / 1000 / qs.execution_count AS avg_elapsed_ms,\n  qs.total_worker_time / 1000 / qs.execution_count AS avg_cpu_ms,\n  qs.total_logical_reads / qs.execution_count AS avg_reads,\n  qs.total_logical_writes / qs.execution_count AS avg_writes,\n  qs.total_elapsed_time / 1000 AS total_elapsed_ms,\n  SUBSTRING(st.text, (qs.statement_start_offset / 2) + 1,\n    ((CASE qs.statement_end_offset WHEN -1 THEN DATALENGTH(st.text) ELSE qs.statement_end_offset END\n      - qs.statement_start_offset) / 2) + 1) AS statement_text\nFROM sys.dm_exec_query_stats qs\nCROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st\nORDER BY qs.total_elapsed_time DESC",
     "format": "table"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
