{
 "uid": "agrovesto-ecs",
 "title": "ECS platform",
 "tags": [
  "agrovesto",
  "ecs"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-12h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(ecs_service_desired_count, service)",
    "includeAll": true,
    "multi": true,
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Running tasks",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(ecs_cluster_running_tasks)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Pending tasks",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(ecs_cluster_pending_tasks)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Services",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(ecs_cluster_services)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Collector reachable",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "ecs_up",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Down",
         "color": "red"
        },
        "1": {
         "text": "Up",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Collector age",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "time() - ecs_scrape_timestamp_seconds",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Log shipper age",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "time() - ecs_logs_scrape_timestamp_seconds",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Tasks running vs desired",
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "ecs_service_running_count",
     "legendFormat": "{{service}}"
    },
    {
     "expr": "ecs_service_desired_count",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Tasks stuck pending",
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "ecs_service_pending_count",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Tasks stopping by stop code",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "ecs_stopped_tasks",
     "legendFormat": "{{stop_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Service state",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "ecs_service_desired_count",
     "format": "table",
     "instant": true
    },
    {
     "expr": "ecs_service_running_count",
     "format": "table",
     "instant": true
    },
    {
     "expr": "ecs_service_pending_count",
     "format": "table",
     "instant": true
    },
    {
     "expr": "ecs_service_deployment_failed",
     "format": "table",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Log lines per service (Loki)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 22
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (service) (rate({source=\"app\"} |= \"\" [5m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "logs",
   "title": "Recent service logs",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 22
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{source=\"app\"} |~ \"(?i)error|exception|fail\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Log lines shipped per group",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 30
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "ecs_logs_shipped_total",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Newest shipped log event age",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 30
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "time() - ecs_logs_last_event_timestamp_seconds",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  }
 ]
}
