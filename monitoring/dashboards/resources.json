   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min(rds_free_storage_space_bytes{db_instance=~\"$db\"})",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "decimals": 1
    },
    "overrides": []
