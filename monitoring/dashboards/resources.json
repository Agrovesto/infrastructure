{
 "uid": "agrovesto-resources",
 "title": "Cloud resources: database, load balancer, network, storage",
 "description": "The basic CloudWatch metrics every AWS resource publishes for free, republished as Prometheus series by the collector task (monitoring/scripts/cw_metrics.py). Container Insights stays off. SQL Server internals (blocked sessions, deadlocks, database size) come from the DMV task and live on the Services dashboard; ECS task state lives on the ECS platform dashboard.",
 "tags": [
  "agrovesto",
  "resources",
  "cloudwatch",
  "capacity"
 ],
 "timezone": "browser",
 "refresh": "1m",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-12h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(ecs_service_desired_count, service)",
    "includeAll": true,
    "multi": true,
    "refresh": 2
   },
   {
    "name": "db",
    "label": "Database",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(rds_cpu_utilization_percent, db_instance)",
    "includeAll": true,
    "multi": true,
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Headline",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Services over 85% CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ecs_service_cpu_utilization_percent > 85) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "ECS services whose average CPU passed 85% in the last window.",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 1
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Unhealthy targets",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(alb_unhealthy_hosts) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "Targets failing their ALB health check right now.",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 4,
    "y": 1
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Database CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(rds_cpu_utilization_percent{db_instance=~\"$db\"})",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 8,
    "y": 1
   }
  },
  {
   "id": 5,
   "type": "stat",
