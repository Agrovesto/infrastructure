    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(nat_gateway_error_port_allocation) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "Failed port allocations mean outbound connections are being dropped.",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 16,
    "y": 1
   }
  },
  {
   "id": 7,
   "type": "stat",
