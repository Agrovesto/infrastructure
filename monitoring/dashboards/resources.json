    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - cloudwatch_collector_timestamp_seconds",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 0
    },
    "overrides": []
   },
   "description": "Age of the last CloudWatch collection run. The collector runs every two minutes and reads a window that lags five minutes behind now.",
