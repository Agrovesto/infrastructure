{
  "uid": "agrovesto-cost",
  "title": "Cost and budget",
  "tags": ["agrovesto", "cost"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Budget utilisation (projected month-end)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "budget_utilization_ratio", "legendFormat": "utilisation" }],
      "options": { "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.5,
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 1.0 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Month-to-date",
      "gridPos": { "h": 7, "w": 5, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "cost_month_to_date_usd", "legendFormat": "USD" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Projected month-end",
      "gridPos": { "h": 7, "w": 5, "x": 13, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "cost_projected_month_usd", "legendFormat": "USD" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Monthly budget",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "budget_month_usd", "legendFormat": "USD" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Top services this month",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "topk(15, cost_by_service_month_to_date_usd)", "legendFormat": "{{service}}", "instant": true, "format": "table" }],
      "options": { "displayMode": "gradient", "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Service breakdown",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sort_desc(cost_by_service_month_to_date_usd)", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "service": "Service", "Value": "USD" } } }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Budget alerts",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "ALERTS{alertname=~\"Budget.*|Cost.*\"}", "legendFormat": "{{alertname}} ({{alertstate}})" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } }, "overrides": [] }
    }
  ]
}
