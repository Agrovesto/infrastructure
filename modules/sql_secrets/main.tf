# Metadata only. Values are generated by the SQL provisioning program inside the
# target VPC, never by Terraform/random_password and never embedded in user data.
resource "aws_secretsmanager_secret" "database" {
  #checkov:skip=CKV2_AWS_57:Per-API login rotation is a coordinated runbook operation followed by service redeploy; RDS master credentials are AWS-managed.

  for_each                = var.databases
  name                    = "${var.project}/${var.environment}/sql/${each.key}"
  description             = "Runtime login for ${each.value}; initialized and rotated by the SQL admin task"
  kms_key_id              = var.kms_key_arn
  recovery_window_in_days = 30
  lifecycle {
    prevent_destroy = true
  }
}
